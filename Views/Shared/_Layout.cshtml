    string GetReportMenu(string role) => role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ? "Reports" : role.Equals("SupportHead", StringComparison.OrdinalIgnoreCase) ? "Team Report" : "My Report";
    string GetRoleHeader(string role) => role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ? "Admin" : role.Equals("SupportHead", StringComparison.OrdinalIgnoreCase) ? "Support Head" : role;
}
