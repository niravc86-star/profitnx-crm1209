@if (canChat)
{
<script>
(function(){
  const endpoint = '@Url.Action("UnreadCount", "Chat")';
  const badges = () => document.querySelectorAll('[data-chat-badge]');
  let lastCount = @chatUnreadCount;
  function renderChatCount(count){
    const display = count > 99 ? '99+' : String(count || 0);
    badges().forEach(badge => { badge.textContent = display; badge.style.display = count > 0 ? '' : 'none'; });
  }
  function notifyIfMinimized(count){
    // Desktop notification when browser/tab is minimized or unfocused and unread count went up.
    const isBackground = document.hidden || document.visibilityState === 'hidden' || !document.hasFocus();
    if (count > lastCount && isBackground && 'Notification' in window && Notification.permission === 'granted') {
      try {
        const title = 'ProfitNx CRM - New Chat Message';
        const body = count === 1 ? 'You have a new chat message.' : `You have ${count} unread chat messages.`;
        const targetUrl = '@Url.Action("Index", "Chat")';
        const tag = 'profitnx-chat';
        if (navigator.serviceWorker && navigator.serviceWorker.controller) {
          navigator.serviceWorker.controller.postMessage({ type: 'SHOW_NOTIFICATION', title, body, icon: '/icons/icon-192.png', tag, url: targetUrl });
          return;
        }
        if (navigator.serviceWorker && navigator.serviceWorker.ready) {
          navigator.serviceWorker.ready.then((reg) => {
            if (reg && reg.showNotification) {
              reg.showNotification(title, { body, icon: '/icons/icon-192.png', tag, renotify: true, requireInteraction: true, data: { url: targetUrl } });
            }
          }).catch(() => {});
          return;
        }
        const n = new Notification(title, { body, icon: '/icons/icon-192.png', tag, renotify: true, requireInteraction: true });
        n.onclick = () => { window.focus(); window.location.href = targetUrl; };
      } catch {}
    }
  }
  async function refreshChatCount(){
    try{
      const response = await fetch(endpoint, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if(!response.ok) return;
      const data = await response.json();
      const count = Number(data.count || 0);
      notifyIfMinimized(count);
      renderChatCount(count);
      lastCount = count;
    }catch{}
  }
  if ('Notification' in window && Notification.permission === 'default') {
    // Ask once, quietly, so minimized-tab alerts can work later. No repeated prompting.
    const requestOnce = function(){
      Notification.requestPermission();
      document.removeEventListener('click', requestOnce);
      document.removeEventListener('touchstart', requestOnce);
    };
    document.addEventListener('click', requestOnce, { once: true });
    document.addEventListener('touchstart', requestOnce, { once: true, passive: true });
  }
  window.setTimeout(refreshChatCount, 1200);
  window.setInterval(refreshChatCount, 8000);
  document.addEventListener('visibilitychange', () => { refreshChatCount(); });
  document.addEventListener('pnx-force-poll', () => { refreshChatCount(); });
})();
</script>
}
