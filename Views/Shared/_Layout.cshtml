@if (canNotifications)
{
<script>
(function(){
  const endpoint = '@Url.Action("UnreadCount", "Notifications")';
  const badges = () => document.querySelectorAll('[data-notification-badge]');
  function renderNotificationCount(count){
    const display = count > 99 ? '99+' : String(count || 0);
    badges().forEach(badge => { badge.textContent = display; badge.style.display = count > 0 ? '' : 'none'; });
  }
  async function refreshNotificationCount(){
    try{
      const response = await fetch(endpoint, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if(!response.ok) return;
      const data = await response.json();
      renderNotificationCount(Number(data.count || 0));
    }catch{}
  }
  window.setTimeout(refreshNotificationCount, 800);
  window.setInterval(refreshNotificationCount, 30000);
  document.addEventListener('visibilitychange', () => { if(!document.hidden) refreshNotificationCount(); });
})();
</script>
<div class="task-flash-stack" id="taskFlashStack" aria-live="polite"></div>
<script>
// Change 1 (2026-08-05): pending-task flash message.
// - Every pending/unread task for THIS logged-in user (already scoped by
//   the server to their rights, same as the notification bell) is combined
//   into ONE flash card instead of one popup per task.
// - Closing the card only snoozes it - if the task(s) are still pending
//   next time we poll, it comes back on its own after a short while. It
//   only stops coming back once the task is actually handled (opened from
//   My Alerts / Notifications, which is what already marks it read).
// - A task that is brand new since this browser last checked (i.e. just
//   got assigned) is always shown right away, even if the snooze for older
//   pending items hasn't expired yet, and even if the CRM tab/window is
//   minimized (uses the same desktop Notification permission already asked
//   for by the chat widget below).
(function(){
  const LIST_ENDPOINT = '@Url.Action("PendingList", "Notifications")';
  const SNOOZE_MS = 5 * 60 * 1000; // "thodi var pachi pacho aapo" - re-show after 5 minutes
  const STORAGE_KEY = 'profitnx.taskFlash.' + '@currentUserId';
  const stack = document.getElementById('taskFlashStack');
  if (!stack) return;

  function loadState(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      return { seen: parsed.seen || {}, dismissedAt: parsed.dismissedAt || {} };
    }catch{ return { seen: {}, dismissedAt: {} }; }
  }
  function saveState(state){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch{}
  }
  let state = loadState();

  function escapeHtml(value){
    return String(value == null ? '' : value).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function render(items, viewAllUrl){
    if (!items.length) { stack.innerHTML = ''; stack.classList.remove('show'); return; }
    // A batch made up only of "User Login Alert" items isn't a task queue -
    // it should read and link like a login alert, not the generic task/
    // notification menu.
    const isLoginOnly = items.every((item) => item.flowType === 'UserLogin' || item.flowType === 'UserLogout');
    const headTitle = isLoginOnly
      ? `Login Alert${items.length > 1 ? 's' : ''} (${items.length})`
      : `Pending Task${items.length > 1 ? 's' : ''} (${items.length})`;
    const footerUrl = isLoginOnly ? items[0].actionUrl : viewAllUrl;
    const footerLabel = isLoginOnly ? 'Open Login History Report' : 'Open All';
    const rows = items.map((item) => `
      <a class="task-flash-item" href="${escapeHtml(item.actionUrl)}">
        <span class="task-flash-item-msg">${escapeHtml(item.message)}</span>
        <span class="task-flash-item-meta">${escapeHtml(item.senderName)} &middot; ${escapeHtml(item.sentDate)}</span>
      </a>`).join('');
    stack.innerHTML = `
      <div class="task-flash-card" role="alert">
        <div class="task-flash-head">
          <span><i class="bi bi-bell-fill"></i> ${headTitle}</span>
          <button type="button" class="task-flash-close" id="taskFlashCloseBtn" title="Close" aria-label="Close">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <div class="task-flash-body">${rows}</div>
        <a class="task-flash-footer" href="${escapeHtml(footerUrl)}">${footerLabel}</a>
      </div>`;
    stack.classList.add('show');
    document.getElementById('taskFlashCloseBtn')?.addEventListener('click', () => {
      const now = Date.now();
      items.forEach((item) => { state.dismissedAt[item.id] = now; });
      saveState(state);
      stack.innerHTML = '';
      stack.classList.remove('show');
    });
  }

  function notifyIfMinimized(newItems){
    if (!newItems || !newItems.length) return;
    const first = newItems[0];
    // Login / Logout alerts → same wording as the in-app Login Alerts card
    const isLoginOnly = newItems.every((item) => item.flowType === 'UserLogin' || item.flowType === 'UserLogout');
    let title, body, targetUrl, tag;
    if (isLoginOnly) {
      title = newItems.length === 1
        ? (first.flowType === 'UserLogout' ? 'User Logout Alert' : 'User Login Alert')
        : ('Login Alerts (' + newItems.length + ')');
      if (newItems.length === 1) {
        body = first.message || title;
        if (first.senderName) body += ' · ' + first.senderName;
        if (first.sentDate) body += ' · ' + first.sentDate;
      } else {
        body = newItems.map((it) => it.message || '').filter(Boolean).slice(0, 3).join(' | ');
        if (newItems.length > 3) body += ' …';
      }
      targetUrl = (first && first.actionUrl) || '/Admin/LoginReport';
      tag = 'profitnx-login-alert-' + (first.id || 'batch');
    } else {
      title = 'ProfitNx CRM - Task Assigned';
      body = newItems.length === 1
        ? `${first.message} (assigned by ${first.senderName})`
        : `You have ${newItems.length} new pending tasks.`;
      targetUrl = (first && first.actionUrl) || '/Notifications';
      tag = 'profitnx-task-' + (first.id || 'batch');
    }
    if (window.ProfitNxDesktopNotify) {
      // Prefer helper; also treat document.hidden so Chrome (which can keep
      // hasFocus true while minimized) still fires the OS notification.
      var bg = window.ProfitNxDesktopNotify.isBackground()
        || document.hidden
        || document.visibilityState === 'hidden';
      window.ProfitNxDesktopNotify.show({
        title, body, url: targetUrl, tag,
        force: bg
      });
      return;
    }
    // Fallback if helper not loaded yet
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    if (!(document.hidden || document.visibilityState === 'hidden' || !document.hasFocus())) return;
    try {
      if (navigator.serviceWorker && navigator.serviceWorker.ready) {
        navigator.serviceWorker.ready.then((reg) => {
          if (reg && reg.showNotification) {
            reg.showNotification(title, { body, icon: '/icons/icon-192.png', tag, renotify: true, requireInteraction: true, data: { url: targetUrl } });
          }
        }).catch(() => {});
      }
      const n = new Notification(title, { body, icon: '/icons/icon-192.png', tag, renotify: true, requireInteraction: true });
      n.onclick = () => { window.focus(); window.location.href = targetUrl; };
    } catch {}
  }

  // Change 2 (2026-09-10): a desktop OS notification for ANY pending
  // notification type (not just brand-new ones) keeps showing every ~90s
  // while the CRM window stays minimized/unfocused and something is still
  // unread - matching the Pending Inquiry attention flow. Previously this
  // only fired once, on the first poll after an item appeared, so if the
  // window was already minimized before that poll ran (or the user missed
  // the single popup) no further desktop notification ever showed for it.
  const DESKTOP_RENOTIFY_MS = 90 * 1000;
  const desktopLastShownKey = STORAGE_KEY + '.desktopLastShown';

  async function poll(){
    try{
      const response = await fetch(LIST_ENDPOINT, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (!response.ok) return;
      const data = await response.json();
      const items = Array.isArray(data.items) ? data.items : [];
      const pendingIds = new Set(items.map((item) => item.id));

      // Anything not pending any more (opened / handled) drops out of both
      // the seen list and the dismissed-until list so it doesn't linger.
      Object.keys(state.seen).forEach((id) => { if (!pendingIds.has(id)) delete state.seen[id]; });
      Object.keys(state.dismissedAt).forEach((id) => { if (!pendingIds.has(id)) delete state.dismissedAt[id]; });

      const newlyAssigned = items.filter((item) => !state.seen[item.id]);
      items.forEach((item) => { state.seen[item.id] = true; });

      const now = Date.now();
      const due = items.filter((item) => {
        if (!state.dismissedAt[item.id]) return true; // never closed, or just newly assigned
        return (now - state.dismissedAt[item.id]) >= SNOOZE_MS;
      });

      const isBackground = document.hidden || document.visibilityState === 'hidden' || !document.hasFocus();
      const lastDesktop = Number(sessionStorage.getItem(desktopLastShownKey) || 0);
      if (newlyAssigned.length) {
        notifyIfMinimized(newlyAssigned);
        if (isBackground) sessionStorage.setItem(desktopLastShownKey, String(now));
      } else if (items.length && isBackground && (now - lastDesktop) > DESKTOP_RENOTIFY_MS) {
        // Nothing new, but the window is still minimized and there is still
        // at least one unread item of any type - remind again.
        notifyIfMinimized(items);
        sessionStorage.setItem(desktopLastShownKey, String(now));
      }
      saveState(state);
      render(due, data.viewAllUrl || '@Url.Action("Index", "Notifications")');
    }catch{}
  }

  if ('Notification' in window && Notification.permission === 'default') {
    const requestOnce = function(){
      Notification.requestPermission();
      document.removeEventListener('click', requestOnce);
      document.removeEventListener('touchstart', requestOnce);
      document.removeEventListener('keydown', requestOnce);
    };
    document.addEventListener('click', requestOnce, { once: true });
    document.addEventListener('touchstart', requestOnce, { once: true, passive: true });
    document.addEventListener('keydown', requestOnce, { once: true });
  }

  window.setTimeout(poll, 1500);
  window.setInterval(poll, 30000);
  document.addEventListener('visibilitychange', () => {
    // Poll both when returning and when going background so desktop notifications
    // can fire before the browser fully throttles timers.
    poll();
  });
  document.addEventListener('pnx-force-poll', () => { poll(); });
})();
</script>
}
