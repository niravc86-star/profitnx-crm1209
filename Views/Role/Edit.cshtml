@model ProfitNx.CRM.ViewModels.RoleFormViewModel
@{ ViewData["Title"] = Model.Id == null ? "Add Role" : "Edit Role"; }
<div class="row justify-content-center"><div class="col-xl-7"><div class="card card-soft border-0"><div class="card-body p-4 p-lg-5">
<form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post" class="row g-4">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LandingPage" class="form-label"></label><input asp-for="LandingPage" class="form-control" /></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
<div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-brand px-4">Save</button><a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a></div>
</form></div></div></div></div>
