@model NotificationFormViewModel
@{ ViewData["Title"] = "Queue Notification"; }
<div class="card border-0 shadow-sm rounded-4 p-4"><form method="post"><div class="row g-3"><div class="col-md-3"><label class="form-label">Channel</label><select asp-for="Channel" class="form-select"><option>CRM</option><option>Email</option><option>WhatsApp</option></select></div><div class="col-md-9"><label class="form-label">Recipient</label><input asp-for="Recipient" class="form-control" placeholder="email or mobile number" /></div><div class="col-md-6"><label class="form-label">Related Type</label><input asp-for="RelatedEntityType" class="form-control" placeholder="Inquiry / Scheme / User" /></div><div class="col-md-6"><label class="form-label">Related Id</label><input asp-for="RelatedEntityId" class="form-control" /></div><div class="col-md-12"><label class="form-label">Message</label><textarea asp-for="Message" class="form-control" rows="5"></textarea></div><div class="col-md-12 d-flex gap-2"><button class="btn btn-brand">Queue</button><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div></form></div>
