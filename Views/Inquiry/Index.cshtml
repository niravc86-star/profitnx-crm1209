                <div class="modal-header"><h5 class="modal-title">Status Timeline - @(string.IsNullOrWhiteSpace(item.FirmName) ? item.PersonName : item.FirmName)</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    @if(history.Any()){
                        <div class="timeline-list timeline-list-scroll">@foreach(var h in history){<div class="timeline-row"><strong>@h.Status</strong><span>@h.UpdateDate.ToString("dd/MM/yyyy hh:mm tt") · @h.UserName</span><p>@h.Note</p>@if(!string.IsNullOrWhiteSpace(h.BillNo)){<span>Bill: @h.BillNo / @(h.BillDate?.ToString("dd/MM/yyyy") ?? "-")</span>}@if(!string.IsNullOrWhiteSpace(h.CloseReason)){<span>Close: @h.CloseReason</span>}</div>}</div>
