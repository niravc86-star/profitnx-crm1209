@section Scripts{
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
flatpickr('.crm-date-picker', { altInput: true, altFormat: 'd/m/Y', dateFormat: 'Y-m-d', allowInput: true });
function focusInquiryReport(){
    const report = document.getElementById('inquiryReport');
    if(!report) return;
    report.scrollIntoView({ behavior: 'smooth', block: 'start' });
    report.classList.remove('report-target-pulse');
    void report.offsetWidth;
    report.classList.add('report-target-pulse');
    window.setTimeout(() => report.classList.remove('report-target-pulse'), 1700);
}
document.querySelectorAll('.js-inquiry-report-link').forEach(link => link.addEventListener('click', function(e){
    if(this.getAttribute('href') === '#inquiryReport'){
        e.preventDefault();
        history.replaceState(null, '', '#inquiryReport');
        focusInquiryReport();
    }
}));
if(window.location.hash === '#inquiryReport') window.setTimeout(focusInquiryReport, 120);
const productPrices = @Html.Raw(productJson);
const partnerMargins = @Html.Raw(partnerMarginJson);
function syncQuickStatus(form){
    const status = form.querySelector('.quick-status')?.value || '';
    form.querySelectorAll('.sold-quick').forEach(x => x.style.display = status === 'Sold' ? '' : 'none');
    form.querySelectorAll('.sold-required').forEach(x => { x.required = status === 'Sold'; });
    // Close reason separate textbox removed — note field is enough for Close.
    form.querySelectorAll('.forward-partner').forEach(x => { x.style.display = status === 'Forwarded to Partner' ? '' : 'none'; x.required = status === 'Forwarded to Partner'; });
    form.querySelectorAll('.forward-user').forEach(x => { x.style.display = status === 'Forwarded to User' ? '' : 'none'; x.required = status === 'Forwarded to User'; });
    const dateInput = form.querySelector('.action-date');
    if(dateInput){ dateInput.required = status !== 'Sold' && status !== 'Close' && !status.startsWith('Forwarded to '); }
    if(status === 'Sold'){
        const pname = form.querySelector('.sold-product')?.value || form.querySelector('.product-name')?.value || '';
        const p = productPrices.find(x => x.name === pname);
        if(p){
            const selectedPartnerId = form.querySelector('.forward-partner')?.value || form.querySelector('input[name="existingPartnerId"]')?.value || '';
            const hasPartner = !!selectedPartnerId;
            const margin = hasPartner ? Number(partnerMargins[selectedPartnerId] || form.querySelector('.forward-partner option:checked')?.dataset.margin || 0) : 0;
            const qty = Math.max(1, Number(form.querySelector('.sold-qty')?.value || 1));
            const multiplier = hasPartner ? (1 - Math.min(100, Math.max(0, margin)) / 100) : 1;
            const amountWithout = (hasPartner ? (p.partnerWithoutGst || 0) : (p.directWithoutGst || 0)) * qty * multiplier;
            const amountWith = (hasPartner ? (p.partnerWithGst || 0) : (p.directWithGst || 0)) * qty * multiplier;
            form.querySelector('.auto-without').value = amountWithout.toFixed(2);
            form.querySelector('.auto-with').value = amountWith.toFixed(2);
            const preview = form.querySelector('.price-source-preview');
            if(preview) preview.textContent = hasPartner
                ? `Partner net price after ${margin.toFixed(2)}% margin: ${amountWithout.toFixed(2)} + GST total ${amountWith.toFixed(2)}`
                : `Direct customer price: ${amountWithout.toFixed(2)} + GST total ${amountWith.toFixed(2)}`;
        }
    }
}
/* Event delegation — works for status forms rendered later in modals */
function bindQuickStatusForm(f){
    if(!f || f.dataset.qsBound === '1') return;
    f.dataset.qsBound = '1';
    f.querySelector('.quick-status')?.addEventListener('change', () => syncQuickStatus(f));
    f.querySelector('.sold-product')?.addEventListener('change', () => syncQuickStatus(f));
    f.querySelector('.sold-qty')?.addEventListener('input', () => syncQuickStatus(f));
    f.querySelector('.forward-partner')?.addEventListener('change', () => syncQuickStatus(f));
    syncQuickStatus(f);
}
function validateQuickStatusSubmit(f, e){
    const note = f.querySelector('.required-note');
    const status = f.querySelector('.quick-status')?.value || '';
    const actionDate = f.querySelector('.action-date');
    // Smart single-save: if note empty, auto-fill a short note from status so user
    // does not need a second click through the Update Note popup.
    if(note && !note.value.trim()){
        var autoNote = '';
        if(status === 'Close') autoNote = 'Closed';
        else if(status === 'Sold') autoNote = 'Sold';
        else if(status && status.indexOf('Forwarded') === 0) autoNote = status;
        else if(status) autoNote = 'Status: ' + status;
        else if(f.querySelector('.quality-status') && f.querySelector('.quality-status').value){
            autoNote = 'Quality: ' + f.querySelector('.quality-status').value;
        }
        if(autoNote){
            note.value = autoNote;
            var trigger = f.querySelector('.qs-note-trigger');
            if(trigger){ trigger.value = autoNote; trigger.classList.remove('is-invalid'); }
            note.classList.remove('is-invalid');
        } else {
            e.preventDefault();
            note.classList.add('is-invalid');
            var trigger2 = f.querySelector('.qs-note-trigger');
            if(trigger2){ trigger2.classList.add('is-invalid'); trigger2.focus(); }
            else note.focus();
            alert('Please select a Status (or write an Update note) before saving.');
            return false;
        }
    }
    // Keep closeReason in sync with note when closing (no separate textbox)
    var closeReasonField = f.querySelector('.close-quick, input[name="closeReason"]');
    if(status === 'Close' && closeReasonField && note){
        closeReasonField.value = note.value.trim();
    }
    if(status === 'Sold'){
        const soldProduct = f.querySelector('.sold-product');
        if(soldProduct && !soldProduct.value.trim()){
            e.preventDefault(); soldProduct.classList.add('is-invalid'); soldProduct.focus(); alert('Product name is required for Sold status.'); return false;
        }
    }
    const qualityEl = f.querySelector('.quality-status');
    const quality = qualityEl ? (qualityEl.value || '') : '';
    if(!status && qualityEl && !quality){
        e.preventDefault(); alert('Please select Status or Genuine Status before saving.'); return false;
    }
    if(!status && !qualityEl){
        e.preventDefault(); alert('Please select Status before saving.'); return false;
    }
    // Action date is mandatory whenever the field is present (except Sold / Close / Forwarded / Not Genuine)
    if(actionDate){
        var dateNeeded = status && status !== 'Sold' && status !== 'Close' && !status.startsWith('Forwarded to ') && quality !== 'Not Genuine';
        // Also require when status not yet chosen but user is trying to save with empty date and a note-only path
        if(dateNeeded && !actionDate.value.trim()){
            e.preventDefault();
            actionDate.classList.add('is-invalid');
            actionDate.focus();
            alert('Action date is required. Please select an Action date before saving.');
            return false;
        }
    }
    if(status === 'Sold' && f.dataset.canImplementationSetup === 'true' && !f.dataset.implementationDecision){
        e.preventDefault();
        const selectedProduct = f.querySelector('.sold-product')?.value || f.dataset.product || '';
        window.ProfitNxCRM?.confirmImplementationSetup({ customer: f.dataset.customer || 'Customer', product: selectedProduct })
            .then(function(decision){
                if(decision === null || typeof decision === 'undefined') return;
                const setupField = f.querySelector('.setup-implementation-value');
                if(setupField) setupField.value = decision ? 'true' : 'false';
                f.dataset.implementationDecision = decision ? 'yes' : 'no';
                // Single save path after implementation decision
                if(typeof f.requestSubmit === 'function') f.requestSubmit();
                else f.submit();
            });
        return false;
    }
    // Single-save: disable button immediately to prevent double submit
    var btn = f.querySelector('.qs-save-status-btn, button[type="submit"]');
    if(btn){
        btn.disabled = true;
        btn.dataset.originalText = btn.textContent;
        btn.textContent = 'Saving…';
    }
    return true;
}
document.addEventListener('submit', function(e){
    var f = e.target;
    if(!f || !f.classList || !f.classList.contains('quick-status-form')) return;
    validateQuickStatusSubmit(f, e);
}, true);
document.addEventListener('change', function(e){
    var t = e.target;
    if(!t) return;
    var f = t.closest && t.closest('.quick-status-form');
    if(!f) return;
    if(t.classList.contains('quick-status') || t.classList.contains('sold-product') || t.classList.contains('sold-qty') || t.classList.contains('forward-partner')){
        bindQuickStatusForm(f);
        syncQuickStatus(f);
    }
});
function initAllQuickStatusForms(){
    document.querySelectorAll('.quick-status-form').forEach(bindQuickStatusForm);
}
if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAllQuickStatusForms);
else initAllQuickStatusForms();
// When status modal opens, re-bind + sync + focus
document.addEventListener('shown.bs.modal', function(ev){
    var modal = ev.target;
    if(!modal || !modal.classList.contains('qs-status-modal')) return;
    var f = modal.querySelector('.quick-status-form');
    if(f){
        bindQuickStatusForm(f);
        syncQuickStatus(f);
        // Re-enable save button if previously left disabled
        var btn = f.querySelector('.qs-save-status-btn, button[type="submit"]');
        if(btn){ btn.disabled = false; if(btn.dataset.originalText) btn.textContent = btn.dataset.originalText; }
    }
});

document.addEventListener('hidden.bs.modal', function(){
    document.querySelectorAll('.modal-backdrop').forEach(x => x.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');
});
</script>
}





@* ===== Status update modals (outside table so sticky/overflow never clips them) ===== *@
@if (canStatus)
{
    @foreach (var item in Model)
    {
        var historyInline = updateMap.ContainsKey(item.Id) ? updateMap[item.Id] : new List<InquiryUpdate>();
        var latestHistoryNoteInline = historyInline.OrderByDescending(x => x.UpdateDate).FirstOrDefault()?.Note;
        var latestRemarkInline = !string.IsNullOrWhiteSpace(item.StatusReason)
            ? item.StatusReason
            : !string.IsNullOrWhiteSpace(latestHistoryNoteInline)
                ? latestHistoryNoteInline
                : item.Remarks;
        var remarkPreview = string.IsNullOrWhiteSpace(latestRemarkInline)
            ? ""
            : (latestRemarkInline.Length > 42 ? latestRemarkInline.Substring(0, 42) + "…" : latestRemarkInline);
        <div class="modal fade qs-status-modal" id="statusModal_@item.Id" tabindex="-1" aria-labelledby="statusModalLabel_@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-md">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h5 class="modal-title fs-6" id="statusModalLabel_@item.Id">
                            <i class="bi bi-arrow-repeat me-1"></i> Update Status
                            <small class="text-muted ms-1">@(string.IsNullOrWhiteSpace(item.FirmName) ? item.PersonName : item.FirmName)</small>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body qs-action-panel pt-2 pb-3">
                        <form asp-action="UpdateStatus" method="post" class="quick-status-form qs-inline-form" data-can-implementation-setup="@(canSetupImplementationFromSold ? "true" : "false")" data-customer="@(string.IsNullOrWhiteSpace(item.FirmName) ? item.PersonName : item.FirmName)" data-product="@item.ProductName">
                        <input type="hidden" name="inquiryId" value="@item.Id" />
                        <input type="hidden" name="setupImplementation" value="false" class="setup-implementation-value" />
                        <input type="hidden" name="amountWithoutGst" class="auto-without" value="@item.AmountWithoutGst" />
                        <input type="hidden" name="amountWithGst" class="auto-with" value="@item.AmountWithGst" />
                        <input type="hidden" class="product-name" value="@item.ProductName" />
                        <input type="hidden" class="product-version" value="@item.VersionType" />
                        <input type="hidden" name="existingPartnerId" value="@item.ForwardedToPartnerId" />

                        @* Row 2: Select Status · Genuine Status *@
                        <div class="qs-action-row qs-action-row-status">
                        <select name="status" class="form-select form-select-sm quick-status qs-control qs-status-select" title="Select Status">
                        <option value="">Select Status</option>
                        @foreach (var s in visibleStatuses) { <option value="@s">@s</option> }
                        </select>
                        @if (string.IsNullOrWhiteSpace(item.InquiryQuality))
                        {
                        <select name="inquiryQuality" class="form-select form-select-sm quality-status qs-control qs-genuine-select" title="Genuine Status">
                        <option value="">Genuine Status</option>
                        <option value="Genuine">Genuine</option>
                        <option value="Not Genuine">Not Genuine</option>
                        </select>
                        }
                        else
                        {
                        <span class="qs-genuine-locked badge status-badge @(item.InquiryQuality=="Genuine"?"bg-soft-success":"bg-soft-danger")" title="Genuine status already set">@item.InquiryQuality</span>
                        }
                        </div>

                        @* Conditional Sold / Close / Forward fields *@
                        @if (canForwardPartner)
                        {
                        <select name="forwardToPartnerId" class="form-select form-select-sm forward-quick forward-partner qs-control qs-extra-field" title="Select partner" style="display:none;">
                        <option value="">Select Partner</option>
                        @foreach (var p in partners) { <option value="@p.Id" data-margin="@(partnerMargins.ContainsKey(p.Id) ? partnerMargins[p.Id] : 0)">@p.FullName</option> }
                        </select>
                        }
                        @if (canForwardUser)
                        {
                        <select name="forwardToUserId" class="form-select form-select-sm forward-quick forward-user qs-control qs-extra-field" title="Select user" style="display:none;">
                        <option value="">Select User</option>
                        @foreach (var u in users) { <option value="@u.Id">@u.FullName (@u.Role)</option> }
                        </select>
                        }
                        <select name="soldProductName" class="form-select form-select-sm sold-quick sold-product sold-required qs-control qs-extra-field" style="display:none;">
                        <option value="">Sold Product</option>
                        @foreach (var p in products) { <option value="@p.Name" selected="@(item.ProductName==p.Name)">@p.Name (@p.Version)</option> }
                        </select>
                        <input name="soldLicenses" type="number" min="1" class="form-control form-control-sm sold-quick sold-qty sold-required qs-control qs-extra-field" placeholder="Qty" value="@(item.LicensesPurchased > 0 ? item.LicensesPurchased : 1)" style="display:none;" />
                        <div class="sold-quick price-source-preview small text-muted qs-extra-field" style="display:none;"></div>
                        <input name="licenseNumber" class="form-control form-control-sm sold-quick sold-required sold-license qs-control qs-extra-field" placeholder="License No" value="@item.LicenseNumber" style="display:none;" />
                        <input name="billNo" class="form-control form-control-sm sold-quick sold-required sold-bill qs-control qs-extra-field" placeholder="Bill No" value="@item.BillNo" style="display:none;" />
                        <input type="text" name="billDate" class="form-control form-control-sm sold-quick sold-required sold-bill-date crm-date-picker qs-control qs-extra-field" placeholder="Bill date" value="@DateValue(item.BillDate)" autocomplete="off" style="display:none;" />
                        <input type="hidden" name="closeReason" class="close-quick" value="" />

                        @* Row 3: Update note (popup trigger) · Action date *@
                        @if (canManageFollowup)
                        {
                        <div class="qs-action-row qs-action-row-note">
                        <input type="hidden" name="note" class="required-note qs-note-full" value="" />
                        <input type="text"
                        class="form-control form-control-sm qs-control qs-note-trigger"
                        placeholder="Update note"
                        readonly
                        data-inquiry-id="@item.Id"
                        data-customer="@(string.IsNullOrWhiteSpace(item.FirmName) ? item.PersonName : item.FirmName)"
                        data-current-note=""
                        value=""
                        title="Click to write a new note"
                        autocomplete="off" />
                        <input type="text"
                        name="nextFollowUp"
                        class="form-control form-control-sm crm-date-picker action-date qs-control"
                        placeholder="Action date"
                        autocomplete="off" />
                        </div>
                        }
                        else
                        {
                        <input type="hidden" name="note" class="required-note" value="" />
                        }

                        @* Row 4: Save Status *@
                        <div class="qs-action-row qs-action-row-save">
                        <button type="submit" class="btn qs-save-status-btn">Save Status</button>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

<div class="modal fade" id="remarksExpandModal" tabindex="-1" aria-labelledby="remarksExpandTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content remarks-expand-modal-content qs-remarks-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="remarksExpandTitle"><i class="bi bi-chat-left-text me-2"></i>Update Note</h5>
                    <div class="mini-muted" id="remarksModalCustomer"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="qs-label mb-1" for="remarksExpandTextarea">Remarks / Update note</label>
                <textarea id="remarksExpandTextarea" class="form-control remarks-expand-textarea" rows="10" placeholder="Write complete remarks or status note here..."></textarea>
                <div class="form-text mt-1">This is staged into Update Status below — it is saved once you press <strong>Save Status</strong>, not before.</div>
                <div id="remarksModalFeedback" class="mt-2 small" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-brand" id="remarksExpandApply">Use this note</button>
            </div>
        </div>
    </div>
</div>
<script>
(function(){
    var activeInquiryId = null;
    var activeTrigger = null;
    var modalEl = document.getElementById('remarksExpandModal');
    var ta = document.getElementById('remarksExpandTextarea');
    var customerEl = document.getElementById('remarksModalCustomer');
    var feedback = document.getElementById('remarksModalFeedback');
    var applyBtn = document.getElementById('remarksExpandApply');
    var remarksModalInst = null;

    function showFb(msg, ok){
        if(!feedback) return;
        feedback.style.display = 'block';
        feedback.className = 'mt-2 small ' + (ok ? 'text-success' : 'text-danger');
        feedback.textContent = msg;
    }
    function previewText(full){
        if(!full) return '';
        return full.length > 42 ? full.substring(0, 42) + '…' : full;
    }
    function openRemarksPopup(trigger){
        activeTrigger = trigger;
        activeInquiryId = trigger.getAttribute('data-inquiry-id');
        if(customerEl) customerEl.textContent = 'Inquiry: ' + (trigger.getAttribute('data-customer') || '');
        if(ta){
            // Always start blank: each entry here is a NEW note, not an edit of
            // the last one. The last saved remark still shows in the compact
            // preview field and in the full history/timeline — it should not
            // be re-loaded into this box for the user to accidentally resend.
            ta.value = '';
            setTimeout(function(){ ta.focus(); }, 280);
        }
        if(feedback){ feedback.style.display = 'none'; feedback.textContent = ''; }
        if(applyBtn) applyBtn.disabled = false;
        if(window.bootstrap && modalEl){
            remarksModalInst = bootstrap.Modal.getOrCreateInstance(modalEl);
            remarksModalInst.show();
        }
    }

    // Clickable Update note field (readonly input acts as trigger)
    document.querySelectorAll('.qs-note-trigger').forEach(function(el){
        el.addEventListener('click', function(e){
            e.preventDefault();
            openRemarksPopup(el);
        });
        el.addEventListener('keydown', function(e){
            if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openRemarksPopup(el); }
        });
    });
    // Legacy buttons if any remain
    document.querySelectorAll('.qs-update-remarks-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
            var parentModal = btn.closest('.modal.show');
            if(parentModal && window.bootstrap){
                var parentInst = bootstrap.Modal.getInstance(parentModal);
                if(parentInst) parentInst.hide();
            }
            openRemarksPopup(btn);
        });
    });

    if(applyBtn){
        applyBtn.addEventListener('click', function(){
            if(!activeInquiryId){ showFb('No inquiry selected.', false); return; }
            var note = (ta && ta.value || '').trim();
            if(!note){ showFb('Remarks are required.', false); if(ta) ta.focus(); return; }

            // SINGLE SAVE: this only stages the note into the Update Status
            // form in memory. It does NOT call the server. The one and only
            // save happens when the user presses "Save Status" — previously
            // this button also posted to UpdateRemarks immediately, which
            // wrote its own history entry, and then Save Status wrote a
            // second one a moment later with the same note (that's what
            // produced the near-duplicate "Follow Up" timeline entries a
            // few minutes apart).
            if(activeTrigger){
                if(activeTrigger.classList.contains('qs-note-trigger')){
                    activeTrigger.value = previewText(note);
                    activeTrigger.classList.remove('is-invalid');
                }
                var form = activeTrigger.closest('form') || (activeTrigger.closest('.qs-action-panel') && activeTrigger.closest('.qs-action-panel').querySelector('form')) || (activeTrigger.closest('.qs-status-modal') && activeTrigger.closest('.qs-status-modal').querySelector('form'));
                if(form){
                    var noteInput = form.querySelector('input[name="note"].required-note, input.required-note, input.qs-note-full');
                    if(noteInput){
                        noteInput.value = note;
                        noteInput.classList.remove('is-invalid');
                    }
                }
            }

            showFb('Note ready — click Save Status to save.', true);
            if(ta) ta.value = '';
            setTimeout(function(){
                if(remarksModalInst) remarksModalInst.hide();
                else if(modalEl && window.bootstrap){
                    var inst = bootstrap.Modal.getInstance(modalEl);
                    if(inst) inst.hide();
                }
                activeTrigger = null;
            }, 200);
        });
    }
})();
</script>
