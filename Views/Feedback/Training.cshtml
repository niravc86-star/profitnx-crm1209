@model CustomerFeedbackViewModel
@{
    Layout = null;
    ViewData["Title"] = "Training Feedback";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profit Nx Training Feedback</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/professional-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="feedback-public-page">
<main class="feedback-shell">
    <section class="feedback-brand-panel">
        <img src="~/img-profit-logo.png" alt="Profit Nx" />
        <span>Implementation & Training</span>
        <h1>Your experience matters.</h1>
        <p>Help us improve the quality of installation, implementation and training delivered to every Profit Nx customer.</p>
        <div class="feedback-company"><small>Feedback for</small><strong>@Model.FirmName</strong><span>@Model.ProductName</span></div>
    </section>
    <section class="feedback-form-panel">
        <div class="feedback-form-heading"><span>Customer Feedback</span><h2>How was your experience?</h2><p>Please select a rating and share your remarks.</p></div>
        <form method="post" asp-action="Training" class="feedback-form">
            @Html.AntiForgeryToken()<input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <label class="form-label">Overall Rating</label>
            <div class="star-rating" role="radiogroup" aria-label="Rating out of five">
                @for (var i = 5; i >= 1; i--)
                {
                    <input type="radio" id="rating-@i" name="Rating" value="@i" checked="@(Model.Rating == i)" />
                    <label for="rating-@i" title="@i star"><i class="bi bi-star-fill"></i></label>
                }
            </div>
            <span asp-validation-for="Rating" class="text-danger"></span>
            <div class="mt-4"><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control" rows="6" placeholder="Tell us what went well and what we can improve (optional)..."></textarea><span asp-validation-for="Remarks" class="text-danger"></span></div>
            <button class="btn btn-primary btn-lg w-100 mt-4">Submit Feedback <i class="bi bi-arrow-right"></i></button>
            <p class="feedback-privacy"><i class="bi bi-shield-check"></i> Your feedback is linked only to your training record.</p>
        </form>
    </section>
</main>
</body></html>
