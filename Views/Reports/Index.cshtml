        ];
        document.getElementById('trnModalGrid').innerHTML = fields.map(function(f){
            return '<div class="inq-detail-item"><span>' + f[0] + '</span><strong>' + (f[1] === '' || f[1] === null || f[1] === undefined ? '-' : f[1]) + '</strong></div>';
        }).join('');
        var noteWrap = document.getElementById('trnModalNoteWrap');
        if(d.lastProgressNote && d.lastProgressNote.trim()){ noteWrap.style.display = ''; document.getElementById('trnModalNote').textContent = d.lastProgressNote; }
        else { noteWrap.style.display = 'none'; }
        var openFull = document.getElementById('trnModalOpenFull');
        if(d.detailsUrl){ openFull.href = d.detailsUrl; openFull.style.display = ''; } else { openFull.style.display = 'none'; }
        var modalEl = document.getElementById('trainingDetailModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    };
})();
function cleanProGridClone(table){
    var clone = table.cloneNode(true);
    clone.querySelectorAll('.pg-filter-pop').forEach(function(p){ p.remove(); });
    clone.querySelectorAll('.pg-filter-btn').forEach(function(b){ b.remove(); });
    clone.querySelectorAll('.sort-caret').forEach(function(s){ s.remove(); });
    clone.querySelectorAll('thead th:last-child, tfoot td:last-child').forEach(function(c){ c.remove(); });
    Array.from(clone.querySelectorAll('tbody tr')).forEach(function(tr){
        var live = table.querySelector('tr[data-id="' + tr.getAttribute('data-id') + '"]');
        if(live && live.style.display === 'none'){ tr.remove(); return; }
        var cells = tr.children;
        if(cells.length) cells[cells.length - 1].remove();
    });
    return clone;
}
function exportProGridExcel(tableId, filenamePrefix, asCsv){
    var table = document.getElementById(tableId);
    if(!table) return;
    var clone = cleanProGridClone(table);
    var stamp = new Date().toISOString().slice(0,10);
    if(asCsv){
        var rows = [];
        clone.querySelectorAll('thead tr:first-child th').forEach(function(th, i){
            rows[0] = rows[0] || [];
            rows[0][i] = th.textContent.trim().replace(/\s+/g,' ');
        });
        clone.querySelectorAll('tbody tr').forEach(function(tr){
            var r = [];
            tr.querySelectorAll('td').forEach(function(td){ r.push('"' + td.textContent.trim().replace(/\s+/g,' ').replace(/"/g,'""') + '"'); });
            rows.push(r);
        });
        var csv = rows.map(function(r){ return r.map(function(c){ return typeof c === 'string' && c.charAt(0) !== '"' ? '"' + c.replace(/"/g,'""') + '"' : c; }).join(','); }).join('\r\n');
        var blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = filenamePrefix + '-' + stamp + '.csv';
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
        return;
    }
    var html = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
    var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filenamePrefix + '-' + stamp + '.xls';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
(function(){
    document.querySelectorAll('table').forEach(function(table){
        var filters = table.querySelectorAll('.col-filter');
        if(!filters.length) return;
        var rows = table.querySelectorAll('tbody tr');
        function applyFilters(){
            var values = {};
            filters.forEach(function(f){ values[f.getAttribute('data-col')] = f.value.trim().toLowerCase(); });
            rows.forEach(function(row){
                var visible = true;
                Object.keys(values).forEach(function(col){
                    var val = values[col];
                    if (!val) return;
                    var cell = row.children[parseInt(col, 10)];
                    var text = cell ? cell.textContent.trim().toLowerCase() : '';
                    var input = table.querySelector('.col-filter[data-col="'+col+'"]');
                    if (input && input.tagName === 'SELECT') { if (text.indexOf(val) === -1) visible = false; }
                    else if (text.indexOf(val) === -1) { visible = false; }
                });
                row.style.display = visible ? '' : 'none';
            });
        }
        filters.forEach(function(f){ f.addEventListener('input', applyFilters); f.addEventListener('change', applyFilters); });
    });
})();
(function(){
    // Column-header click-to-sort, generalized to every Pro Grid table on the page.
    document.querySelectorAll('table.pg-table').forEach(function(table){
        var tbody = table.querySelector('tbody');
        var headers = table.querySelectorAll('thead tr:first-child th');
        var state = { col: -1, dir: 1 };
        function cellSortValue(row, idx, type){
            var cell = row.children[idx];
            if(!cell) return type === 'num' ? -Infinity : '';
            if(cell.hasAttribute('data-sort')){
                var raw = cell.getAttribute('data-sort');
                if(type === 'num'){ var nv = parseFloat(raw); return isNaN(nv) ? -Infinity : nv; }
                return raw.toLowerCase();
            }
            var text = cell.textContent.trim();
            if(type === 'num'){
                var n = parseFloat(text.replace(/[^0-9.\-]/g, ''));
                return isNaN(n) ? -Infinity : n;
            }
            return text.toLowerCase();
        }
        headers.forEach(function(th, idx){
            if(th.classList.contains('no-sort')) return;
            th.addEventListener('click', function(e){
                if(e.target.closest('.pg-filter-btn') || e.target.closest('.pg-filter-pop')) return;
                var type = th.getAttribute('data-type') || 'text';
                var dir = (state.col === idx) ? -state.dir : 1;
                state = { col: idx, dir: dir };
                headers.forEach(function(h){ h.classList.remove('sort-asc','sort-desc'); });
                th.classList.add(dir === 1 ? 'sort-asc' : 'sort-desc');
                var rows = Array.from(tbody.querySelectorAll('tr')).filter(function(r){ return r.children.length > 1; });
                rows.sort(function(a, b){
                    var av = cellSortValue(a, idx, type), bv = cellSortValue(b, idx, type);
                    if(av < bv) return -1 * dir;
                    if(av > bv) return 1 * dir;
                    return 0;
                });
                rows.forEach(function(r){ tbody.appendChild(r); });
            });
        });
    });
})();
(function(){
    // Per-column filter popovers (the funnel icon next to each header) for every Pro Grid table.
    document.querySelectorAll('table.pg-table').forEach(function(table){
        table.querySelectorAll('.pg-filter-btn').forEach(function(btn){
            btn.addEventListener('click', function(e){
                e.stopPropagation();
                var th = btn.closest('th');
                var pop = th.querySelector('.pg-filter-pop');
                if(!pop) return;
                var wasOpen = pop.classList.contains('show');
                document.querySelectorAll('.pg-filter-pop.show').forEach(function(p){ p.classList.remove('show'); });
                if(!wasOpen){
                    pop.classList.add('show');
                    var inp = pop.querySelector('input,select');
                    if(inp) inp.focus();
                }
            });
        });
        table.querySelectorAll('.pg-filter-pop').forEach(function(pop){
            pop.addEventListener('click', function(e){ e.stopPropagation(); });
            var inp = pop.querySelector('.col-filter');
            var btn = pop.closest('th') ? pop.closest('th').querySelector('.pg-filter-btn') : null;
            if(inp && btn){
                var syncActive = function(){ btn.classList.toggle('pg-filter-active', !!inp.value); };
                inp.addEventListener('input', syncActive);
                inp.addEventListener('change', syncActive);
            }
        });
    });
    document.addEventListener('click', function(e){
        if(e.target.closest('.pg-filter-pop') || e.target.closest('.pg-filter-btn')) return;
        document.querySelectorAll('.pg-filter-pop.show').forEach(function(p){ p.classList.remove('show'); });
    });
})();
</script>
}
