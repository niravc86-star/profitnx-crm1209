@section Scripts{
<script>
const reportFilter=document.getElementById('reportGlobalFilter');
if(reportFilter){reportFilter.addEventListener('input',function(){const q=this.value.toLowerCase();document.querySelectorAll('table tbody tr').forEach(tr=>{tr.style.display=tr.innerText.toLowerCase().includes(q)?'':'none';});});}
(function(){
    // DD/MM/YYYY masked date inputs used across report filter bars.
    function syncHidden(inp){
        var target = document.getElementById(inp.getAttribute('data-hidden-target'));
        if(!target) return;
        var m = inp.value.trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if(m){ target.value = m[3] + '-' + m[2] + '-' + m[1]; }
        else if(inp.value.trim() === ''){ target.value = ''; }
    }
    document.querySelectorAll('.dmy-date-input').forEach(function(inp){
        inp.addEventListener('input', function(){
            var digits = this.value.replace(/[^0-9]/g, '').slice(0, 8);
            var out = digits;
            if(digits.length > 4) out = digits.slice(0,2) + '/' + digits.slice(2,4) + '/' + digits.slice(4);
            else if(digits.length > 2) out = digits.slice(0,2) + '/' + digits.slice(2);
            this.value = out;
            syncHidden(this);
        });
        inp.addEventListener('blur', function(){ syncHidden(this); });
    });
})();
(function(){
    // Quick search boxes for the Pro Grid reports (Total Inquiry List & Implementation/Training).
    function wireQuickSearch(searchId, tableId){
        var quick = document.getElementById(searchId);
        var table = document.getElementById(tableId);
        if(!quick || !table) return;
        quick.addEventListener('input', function(){
            var q = this.value.trim().toLowerCase();
            table.querySelectorAll('tbody tr').forEach(function(tr){
                if(tr.children.length < 2){ return; }
                tr.style.display = tr.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    }
    wireQuickSearch('sourceGridQuickSearch', 'sourceReportTable');
    wireQuickSearch('trainingGridQuickSearch', 'trainingReportTable');
})();
(function(){
    // Row-click detail popup for the Total Inquiry List grid.
    var el = document.getElementById('sourceInquiryDataJson');
    if(!el) return;
    var inquiryData = {};
    try{
        JSON.parse(el.textContent).forEach(function(x){ inquiryData[x.id] = x; });
    }catch(e){ return; }
    window.openInquiryDetail = function(id){
        var d = inquiryData[id];
        if(!d) return;
        var name = d.firm && d.firm.trim() ? d.firm : (d.person || 'Inquiry');
        document.getElementById('inqModalCustomer').textContent = name;
        document.getElementById('inqModalMeta').textContent = (d.person && d.firm ? d.person + ' · ' : '') + [d.city, d.mobile1].filter(Boolean).join(' · ');
        var statusEl = document.getElementById('inqModalStatus');
        statusEl.textContent = d.status || '-';
        statusEl.className = 'status-badge ' + (d.status === 'Sold' ? 'bg-soft-success' : d.status === 'Close' ? 'bg-soft-danger' : (d.status === 'Follow Up' ? 'bg-soft-warning' : 'bg-soft-primary'));
        document.getElementById('inqModalSourceChip').innerHTML = '<span class="source-avatar" style="width:26px;height:26px;font-size:.72rem">' + (d.source ? d.source.charAt(0).toUpperCase() : '?') + '</span><span>' + (d.source || '-') + '</span>';
        var fields = [
            ['Inquiry Date', d.date], ['Mobile', [d.mobile1, d.mobile2].filter(Boolean).join(', ') || '-'],
            ['Email', [d.email1, d.email2].filter(Boolean).join(', ') || '-'], ['City', d.city || '-'],
            ['Product', [d.product, d.version].filter(Boolean).join(' · ') || '-'], ['Inquiry Quality', d.quality || '-'],
            ['Assigned / Forwarded To', d.assignedTo || '-'], ['Handled By', d.assignedRole || '-'],
            ['Forwarded By', d.forwardedBy || '-'], ['Forwarded Date', d.forwardedDate || '-'],
            ['Next Follow-up', d.nextFollowUp || '-'], ['Demo Scheduled', d.demoScheduled || '-'],
            ['Demo Done', d.demoDone || '-'], ['Status Reason', d.statusReason || '-'],
            ['Sold By', [d.soldBy, d.soldByRole].filter(Boolean).join(' · ') || '-'], ['Sold Date', d.soldDate || '-'],
            ['Licenses', d.licenses != null ? d.licenses : '-'], ['License No.', d.licenseNumber || '-'],
            ['Bill No.', d.billNo || '-'], ['Bill Date', d.billDate || '-'],
            ['Amount (w/o GST)', d.amount != null ? d.amount : 'Hidden'], ['Amount (with GST)', d.amountGst != null ? d.amountGst : 'Hidden'],
            ['Dealer', d.dealerName || '-']
        ];
        document.getElementById('inqModalGrid').innerHTML = fields.map(function(f){
            return '<div class="inq-detail-item"><span>' + f[0] + '</span><strong>' + (f[1] === '' || f[1] === null || f[1] === undefined ? '-' : f[1]) + '</strong></div>';
        }).join('');
        var remarksWrap = document.getElementById('inqModalRemarksWrap');
        if(d.remarks && d.remarks.trim()){ remarksWrap.style.display = ''; document.getElementById('inqModalRemarks').textContent = d.remarks; }
        else { remarksWrap.style.display = 'none'; }
        var openFull = document.getElementById('inqModalOpenFull');
        if(d.detailsUrl){ openFull.href = d.detailsUrl; openFull.style.display = ''; } else { openFull.style.display = 'none'; }
        var modalEl = document.getElementById('inquiryDetailModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    };
})();
(function(){
    // Row-click detail popup for the Implementation / Training Report grid.
    var el = document.getElementById('trainingCaseDataJson');
    if(!el) return;
    var caseData = {};
    try{
        JSON.parse(el.textContent).forEach(function(x){ caseData[x.id] = x; });
    }catch(e){ return; }
    window.openTrainingDetail = function(id){
        var d = caseData[id];
        if(!d) return;
        var name = d.firm && d.firm.trim() ? d.firm : (d.person || 'Implementation Case');
        document.getElementById('trnModalCustomer').textContent = name;
        document.getElementById('trnModalMeta').textContent = (d.person && d.firm ? d.person + ' · ' : '') + [d.city, d.mobile].filter(Boolean).join(' · ');
        var statusEl = document.getElementById('trnModalStatus');
        statusEl.textContent = (d.status || '-') + (d.stage ? ' · ' + d.stage : '');
        var fields = [
            ['Sale Date', d.saleDate], ['Mobile', d.mobile || '-'], ['Email', d.email || '-'], ['City', d.city || '-'],
            ['Product', d.product || '-'], ['License No.', d.licenseNumber || '-'], ['License Count', d.licenseCount != null ? d.licenseCount : '-'],
            ['PIN Number', d.pinNumber || '-'], ['Bill Number', d.billNumber || '-'],
            ['Sold By', [d.soldBy, d.soldByRole].filter(Boolean).join(' · ') || '-'], ['Support Head', d.supportHead || '-'],
            ['Assigned Member', d.assignedMember || '-'], ['Priority', d.priority || '-'], ['Progress', (d.progressPercent != null ? d.progressPercent : '-') + '%'],
            ['Preferred Start', d.preferredStartDate], ['Preferred Time', d.preferredTime || '-'],
            ['Actual Start', d.actualStartDate], ['Completion Date', d.completionDate],
            ['Training Completed', d.isTrainingCompleted], ['Paused', d.isPaused + (d.pauseReason ? ' (' + d.pauseReason + ')' : '')],
            ['Reopened', d.reopenedCount > 0 ? 'Yes x' + d.reopenedCount : 'No'], ['Last Reopened', d.lastReopenedDate],
            ['Paid Training', d.isPaidTraining], ['Paid Amount', d.paidTrainingAmount],
