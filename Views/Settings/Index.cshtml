@inject ProfitNx.CRM.Services.IPermissionService PermissionService
@{
    ViewData["Title"] = "Settings";
    ViewData["Subtitle"] = "Configure communication channels and onboarding automation.";
    var canManageSettings = await PermissionService.HasPermissionAsync(User, "settings.manage");
}
@if (!canManageSettings)
{
    <div class="alert alert-info border-0 rounded-3">You have view-only access. Ask an administrator to grant <strong>Settings Manage</strong> right for editing.</div>
}
<div class="settings-grid">
    <div class="crm-panel">
        <div class="panel-heading"><div><span class="section-label">Communication</span><h3>Email SMTP Setup</h3><p>Required for automatic internal emails and customer feedback links.</p></div><i class="bi bi-envelope-check settings-icon"></i></div>
        <form method="post" class="row g-3" data-view-only="@(!canManageSettings)">
            @Html.AntiForgeryToken()<input type="hidden" name="section" value="smtp" />
            <div class="col-md-8"><label class="form-label">SMTP Host</label><input name="host" value="@ViewBag.Host" class="form-control" placeholder="smtp.gmail.com" /></div>
            <div class="col-md-4"><label class="form-label">Port</label><input name="port" value="@ViewBag.Port" class="form-control" placeholder="587" /></div>
            <div class="col-md-6"><label class="form-label">From Email</label><input name="from" value="@ViewBag.From" class="form-control" placeholder="support@profitnx.com" /></div>
            <div class="col-md-6"><label class="form-label">Username</label><input name="username" value="@ViewBag.Username" class="form-control" /></div>
            <div class="col-12"><label class="form-label">Password / App Password</label><input name="password" value="@ViewBag.Password" type="password" class="form-control" /></div>
            @if (canManageSettings) { <div class="col-12"><button class="btn btn-primary"><i class="bi bi-check2"></i> Save SMTP</button></div> }
        </form>
    </div>

    <div class="crm-panel">
        <div class="panel-heading"><div><span class="section-label">Channels</span><h3>Notification Delivery</h3><p>Select which channels should be generated by CRM workflows.</p></div><i class="bi bi-bell settings-icon"></i></div>
        <form method="post" class="settings-switch-list" data-view-only="@(!canManageSettings)">
            @Html.AntiForgeryToken()<input type="hidden" name="section" value="notifications" />
            <label class="settings-switch"><span><strong>CRM Notifications</strong><small>Automatic in-app alerts and unread badge</small></span><input type="checkbox" value="true" name="notificationCrm" @(ViewBag.NotificationCrm ? "checked" : "") /><input type="hidden" name="notificationCrm" value="false" /></label>
            <label class="settings-switch"><span><strong>Email Notifications</strong><small>Send through configured SMTP account</small></span><input type="checkbox" value="true" name="notificationEmail" @(ViewBag.NotificationEmail ? "checked" : "") /><input type="hidden" name="notificationEmail" value="false" /></label>
            <label class="settings-switch"><span><strong>WhatsApp Reminders</strong><small>Create ready-to-send WhatsApp Web/App notification links</small></span><input type="checkbox" value="true" name="notificationWhatsApp" @(ViewBag.NotificationWhatsApp ? "checked" : "") /><input type="hidden" name="notificationWhatsApp" value="false" /></label>
            <label class="settings-switch"><span><strong>Use WhatsApp App Link</strong><small>Use mobile/desktop app link instead of web link</small></span><input type="checkbox" value="true" name="whatsAppUseApp" @(ViewBag.NotificationWhatsAppUseApp ? "checked" : "") /><input type="hidden" name="whatsAppUseApp" value="false" /></label>
            @if (canManageSettings) { <button class="btn btn-primary align-self-start"><i class="bi bi-check2"></i> Save Channels</button> }
        </form>
        <div class="settings-note"><i class="bi bi-info-circle"></i><span>CRM and email can be automatic. Free WhatsApp Web/App requires a user to open the generated notification and press Send.</span></div>
    </div>

    <div class="crm-panel settings-wide">
        <div class="panel-heading"><div><span class="section-label">Customer Success</span><h3>Implementation & Training Automation</h3><p>Control Sold handover reminders, schedule alerts and feedback delivery.</p></div><i class="bi bi-diagram-3 settings-icon"></i></div>
        <form method="post" class="row g-4" data-view-only="@(!canManageSettings)">
            @Html.AntiForgeryToken()<input type="hidden" name="section" value="implementation" />
            <div class="col-md-5"><label class="form-label">Feedback Receiver Email</label><input name="feedbackReceiverEmail" value="@ViewBag.ImplementationFeedbackEmail" type="email" class="form-control" placeholder="support@profitnx.com" /><div class="form-text">Fallback receiver email. Feedback responses are also emailed to active Admin, Support Head, assigned Support user and related CRM user. When an Admin user has SMTP configured, that Admin email is used as the sender so replies return to that mailbox.</div></div>
            <div class="col-md-2"><label class="form-label">Reminder Before</label><div class="input-group"><input name="reminderMinutes" value="@ViewBag.ImplementationReminderMinutes" type="number" min="5" max="120" class="form-control" /><span class="input-group-text">min</span></div></div>
            <div class="col-md-5"><label class="form-label">Public CRM Base URL</label><input name="publicBaseUrl" value="@ViewBag.ImplementationPublicBaseUrl" class="form-control" placeholder="https://crm.profitnx.com" /><div class="form-text">Used in internal emails and customer feedback links after publishing.</div></div>
            <div class="col-md-6"><div class="settings-switch settings-switch-bordered"><span><strong>Sold → Implementation Handover</strong><small>When an authorised Admin, User or Partner marks an inquiry Sold, CRM asks whether implementation setup should be created. Control access from Role Wise or User Wise Rights.</small></span><i class="bi bi-shield-check text-primary fs-4"></i></div></div>
            <div class="col-md-6"><label class="settings-switch settings-switch-bordered"><span><strong>Notify all Admin users</strong><small>Include all active Admin users in schedule and reminder events.</small></span><input type="checkbox" value="true" name="notifyAllAdmins" @(ViewBag.ImplementationNotifyAllAdmins ? "checked" : "") /><input type="hidden" name="notifyAllAdmins" value="false" /></label></div>
            @if (canManageSettings) { <div class="col-12"><button class="btn btn-primary"><i class="bi bi-check2-circle"></i> Save Automation Settings</button></div> }
        </form>
    </div>
</div>

@section Scripts{<script>document.querySelectorAll('[data-view-only="True"] input, [data-view-only="True"] select, [data-view-only="True"] textarea, [data-view-only="True"] button').forEach(x => x.disabled = true);</script>}
